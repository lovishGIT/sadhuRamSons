# ==============================================================================
# Kisan Mitra (Sadhu Ram & Sons) - Environment Configuration Template
# Copy this file to .env and customize values as needed.
# Used natively by Flutter with: --dart-define-from-file=.env
# ==============================================================================

# Environment Mode (development / staging / production)
APP_ENV=production
APP_NAME=Kisan Mitra - Sadhu Ram & Sons
APP_VERSION=1.0.0

# Image CDN Configuration (Automatic WebP transforms)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/sadhuram
CLOUDINARY_CLOUD_NAME=sadhuramsons
IMAGE_OPTIMIZATION_QUALITY=60
IMAGE_OPTIMIZATION_WIDTH=500

# Video Streaming (Unlisted YouTube adaptive HLS streaming)
YOUTUBE_EMBED_BASE_URL=https://www.youtube-nocookie.com/embed
YOUTUBE_API_KEY=

# Regional & Helpline Configuration
DEFAULT_LOCALE=hi
FARMER_HELPLINE=7355555441

# Deep Linking Declarative Routing
DEEP_LINK_SCHEME=sadhuram
DEEP_LINK_HOST=sadhuram.app
